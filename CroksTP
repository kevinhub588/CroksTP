    tp.Position = UDim2.new(1, -92, 0.5, -11)
    tp.BackgroundColor3 = COL_ACCENT2
    tp.BorderSizePixel = 0
    tp.Font = Enum.Font.GothamBold
    tp.TextSize = 10
    tp.TextColor3 = Color3.fromRGB(255, 255, 255)
    tp.Text = "TP"
    tp.Parent = row
    Instance.new("UICorner", tp).CornerRadius = UDim.new(0, 4)
    tp.MouseButton1Click:Connect(function()
        local ok, err = teleportTo(player)
        notify(ok and ("TP -> " .. player.Name) or (err or "Falhou"), ok)
    end)

    local cam = Instance.new("TextButton")
    cam.Size = UDim2.new(0, 42, 0, 22)
    cam.Position = UDim2.new(1, -46, 0.5, -11)
    cam.BackgroundColor3 = COL_ACCENT
    cam.BorderSizePixel = 0
    cam.Font = Enum.Font.GothamBold
    cam.TextSize = 10
    cam.TextColor3 = Color3.fromRGB(255, 255, 255)
    cam.Text = "CAM"
    cam.Parent = row
    Instance.new("UICorner", cam).CornerRadius = UDim.new(0, 4)
    cam.MouseButton1Click:Connect(function() spectate(player, cam) end)

    if Spectating.active and Spectating.target == player then
        cam.Text = "STOP"
        cam.BackgroundColor3 = COL_DANGER
        Spectating.activeBtn = cam
    end

    rows[player] = { row = row, cam = cam }
end

local function removeRow(player)
    local r = rows[player]
    if r then r.row:Destroy(); rows[player] = nil end
    if Spectating.active and Spectating.target == player then stopSpectate() end
end

for _, p in ipairs(Players:GetPlayers()) do buildRow(p) end
