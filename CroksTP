-- ============ SPECTATE ============
local Spectating = { active = false, target = nil, conn = nil, activeBtn = nil }

local function updateStopBtn()
    if Spectating.active then
        stopCamBtn.Visible = true
        stopCamBtn.Size = UDim2.new(0, 68, 0, 16)
        stopCamBtn.Position = UDim2.new(1, -74, 0, 6)
        stopCamBtn.Text = "STOP"
    else
        stopCamBtn.Visible = false
        stopCamBtn.Size = UDim2.new(0, 0, 0, 0)
    end
end

local function stopSpectate()
    if Spectating.conn then Spectating.conn:Disconnect() end
    Spectating.conn = nil
    Spectating.active = false
    Spectating.target = nil
    if Spectating.activeBtn then
        pcall(function()
            Spectating.activeBtn.Text = "CAM"
            Spectating.activeBtn.BackgroundColor3 = COL_ACCENT
        end)
        Spectating.activeBtn = nil
    end
    local myChar = LocalPlayer.Character
    if myChar then
        local hum = myChar:FindFirstChildWhichIsA("Humanoid")
        if hum then
            workspace.CurrentCamera.CameraSubject = hum
            workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
        end
    end
    updateStopBtn()
end

local function spectate(player, btn)
    if Spectating.active and Spectating.target == player then
        stopSpectate(); notify("Camera parada", true); return
    end
    stopSpectate()
    if not player.Character then notify("Alvo sem personagem", false); return end
    local hum = player.Character:FindFirstChildWhichIsA("Humanoid")
    if not hum then notify("Alvo sem humanoid", false); return end
    Spectating.active = true
    Spectating.target = player
    Spectating.activeBtn = btn
    workspace.CurrentCamera.CameraSubject = hum
    workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
    btn.Text = "STOP"
    btn.BackgroundColor3 = COL_DANGER
    Spectating.conn = player.CharacterAdded:Connect(function(char)
        local newHum = char:WaitForChild("Humanoid", 5)
        if newHum and Spectating.active and Spectating.target == player then
            workspace.CurrentCamera.CameraSubject = newHum
        end
    end)
    updateStopBtn()
    notify("Camera: " .. player.Name, true)
end

stopCamBtn.MouseButton1Click:Connect(stopSpectate)

-- ============ TP ============
local function teleportTo(player)
    if player == LocalPlayer then return false, "Você já é você" end
    local myChar = LocalPlayer.Character
    if not myChar then return false, "Sem personagem" end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return false, "Sem HRP" end
    if not player.Character then return false, "Alvo sem personagem" end
    local tHRP = player.Character:FindFirstChild("HumanoidRootPart")
    if not tHRP then return false, "Alvo sem HRP" end
    myHRP.CFrame = tHRP.CFrame * CFrame.new(0, 0, 3)
    return true
end

